root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,jsonc,yml,yaml,ts,tsx,js,css,html,md}]
indent_size = 2

[*.{csproj,slnx,props,targets,xml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

# Windows PowerShell 5.1 bez BOM czyta plik jako ANSI i psuje polskie znaki
[*.ps1]
charset = utf-8-bom

[*.cs]
csharp_style_namespace_declarations = file_scoped:warning
csharp_style_var_for_built_in_types = true:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_prefer_braces = true:suggestion
dotnet_sort_system_directives_first = true

# Pliki generowane przez EF Core – nie poprawiamy ich stylu
[**/Migrations/**.cs]
generated_code = true
