{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build: api",
      "type": "process",
      "command": "dotnet",
      "args": ["build", "${workspaceFolder}/api/NotesApi.csproj", "--property:GenerateFullPaths=true", "-consoleloggerparameters:NoSummary"],
      "group": "build",
      "problemMatcher": "$msCompile"
    },
    {
      "label": "build: functions",
      "type": "process",
      "command": "dotnet",
      "args": ["build", "--property:GenerateFullPaths=true", "-consoleloggerparameters:NoSummary"],
      "options": { "cwd": "${workspaceFolder}/functions/NotesFunctions" },
      "group": "build",
      "problemMatcher": "$msCompile"
    },
    {
      "label": "test",
      "type": "process",
      "command": "dotnet",
      "args": ["test", "${workspaceFolder}/AzureDemoNotes.slnx"],
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": "$msCompile"
    },
    {
      // Wymaga rozszerzenia Azure Functions (typ zadania "func").
      "label": "func: host start",
      "type": "func",
      "command": "host start",
      "options": { "cwd": "${workspaceFolder}/functions/NotesFunctions/bin/Debug/net10.0" },
      "dependsOn": "build: functions",
      "isBackground": true,
      "problemMatcher": "$func-dotnet-watch"
    },
    {
      "label": "azurite",
      "type": "shell",
      "command": "npx azurite --location .azurite --skipApiVersionCheck",
      "options": { "cwd": "${workspaceFolder}" },
      "isBackground": true,
      "problemMatcher": {
        "pattern": { "regexp": "^x^" },
        "background": { "activesBegin": ".", "beginsPattern": "Azurite", "endsPattern": "successfully listening" }
      }
    },
    {
      "label": "web: dev",
      "type": "npm",
      "script": "dev",
      "path": "web",
      "isBackground": true,
      "problemMatcher": {
        "pattern": { "regexp": "^x^" },
        "background": { "activesBegin": ".", "beginsPattern": "VITE", "endsPattern": "Local:" }
      }
    }
  ]
}
