{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "Provider": "Sqlite"
  },
  "ConnectionStrings": {
    "Notes": "Data Source=notes.db"
  },
  "Storage": {
    "ConnectionString": "",
    "ContainerName": "photos",
    "ThumbnailContainerName": "thumbnails",
    "ReadUrlLifetimeMinutes": 15
  },
  "Cleanup": {
    "MinBlobAgeMinutes": 60
  },
  "Cors": {
    "AllowedOrigins": []
  }
}
